{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "STZO Agent",
	"version": "../../package.json",
	"identifier": "cn.stzo.agent",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://127.0.0.1:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "STZO Agent",
				"width": 1240,
				"height": 820,
				"minWidth": 880,
				"minHeight": 560,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"trafficLightPosition": {
					"x": 18,
					"y": 22
				},
				"backgroundColor": "#EEF2F6",
				"dragDropEnabled": false
			}
		],
		"security": {
			"csp": "default-src 'self'; img-src 'self' data: blob: asset: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://gc.stzo.cn https://api.github.com"
		}
	},
	"bundle": {
		"active": true,
		"targets": [
			"app",
			"dmg",
			"nsis"
		],
		"category": "DeveloperTool",
		"shortDescription": "STZO Agent — AI 编程助手",
		"copyright": "© 2026 xltzsoft",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"externalBin": [
			"binaries/node"
		],
		"resources": {
			"app/": "app/"
		},
		"createUpdaterArtifacts": true,
		"macOS": {
			"minimumSystemVersion": "11.0",
			"signingIdentity": "-",
			"entitlements": "Entitlements.plist"
		},
		"windows": {
			"nsis": {
				"installMode": "currentUser",
				"languages": [
					"SimpChinese",
					"English"
				],
				"displayLanguageSelector": false
			}
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBEN0REMDU5ODcwRDYyQkMKUldTOFlnMkhXZEI5RFFENTA4b1l1bWxWRzVyOVNrZC9NNUNSanJlMnh3cHpmNzVyejdjbGN5RFMK",
			"endpoints": [
				"https://gc.stzo.cn/agent/api/update/desktop/{{target}}/{{arch}}/{{current_version}}",
				"https://github.com/xltzsoft/stzo-agent/releases/latest/download/latest.json"
			],
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
