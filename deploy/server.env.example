# /etc/stzo-agent/server.env  (chmod 600, owned by root)
HOST=127.0.0.1
PORT=3090
MOUNT_PATH=/agent
PUBLIC_BASE=https://gc.stzo.cn
SUB2API_URL=http://127.0.0.1:8080
SUB2API_ADMIN_KEY=admin-xxxxxxxx
DATA_DIR=/var/lib/stzo-agent
GITHUB_REPO=xltzsoft/stzo-agent
# Optional: raises the GitHub API rate limit for the OTA mirror
GITHUB_TOKEN=
SHOP_API=https://www.16688.com.cn
SHOP_NO=S670281
# Optional JSON merged into /agent/api/config (announcement, min_version, recommended_model…)
CLIENT_CONFIG_FILE=/etc/stzo-agent/client-config.json
